# LLM providers used as eval judges (cheap/fast model for scoring, not the target system)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Langfuse — optional trace + score push (leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Judge model + primary provider (groq | openrouter). The other provider is
# used as fallback when its API key is also set.
EVAL_JUDGE_MODEL=llama-3.3-70b-versatile
EVAL_JUDGE_PROVIDER=groq

# Path to the SQLite trend store (baselines + run history)
TREND_DB_PATH=./veris_trends.db

# Golden dataset directory (YAML cases)
GOLDEN_DATASET_DIR=./golden_dataset

# --- Target under test (veris.targets.my_agent_fn) ---
# OpenAI-compatible Chat Completions endpoint. Point this at your real
# agent proxy (LangGraph/FastAPI/etc.) or a provider used as a stand-in.
# TARGET_PROVIDER=groq|openrouter|openai|custom
TARGET_PROVIDER=groq
TARGET_MODEL=llama-3.3-70b-versatile
# TARGET_API_KEY=          # defaults to GROQ_/OPENROUTER_/OPENAI_API_KEY
# TARGET_BASE_URL=         # required for TARGET_PROVIDER=custom
# TARGET_SYSTEM_PROMPT=    # optional system message prepended to each case
TARGET_TIMEOUT_S=30
TARGET_TEMPERATURE=0
