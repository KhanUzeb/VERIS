# LLM providers used as eval judges (cheap/fast model for scoring, not the target system).
# Set BOTH keys so Groq and OpenRouter can fail over to each other.
# WARNING: failover sends case prompts (inputs/outputs/context) to the other provider.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Primary provider: groq | openrouter
EVAL_JUDGE_PROVIDER=groq

# Groq model (used whenever Groq is primary or fallback)
EVAL_JUDGE_MODEL=llama-3.3-70b-versatile

# OpenRouter model (used whenever OpenRouter is primary or fallback).
# Default openrouter/free = Free Models Router (auto-picks an available free model).
# Or pin a free variant: meta-llama/llama-3.3-70b-instruct:free
EVAL_OPENROUTER_MODEL=openrouter/free

# Cross-provider failover on daily quota / hard errors (0 = primary only)
EVAL_JUDGE_FAILOVER=1

# Keep these low on free tiers (cases × metrics fan out judge calls).
EVAL_MAX_WORKERS=2
EVAL_JUDGE_CONCURRENCY=2

# Path to the SQLite trend store (baselines + run history)
TREND_DB_PATH=./veris_trends.db

# Golden dataset directory (YAML cases)
GOLDEN_DATASET_DIR=./golden_dataset
